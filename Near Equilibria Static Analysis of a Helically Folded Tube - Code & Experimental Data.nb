       RowBox[{"n", "=", "0"}]}]]}], "=", "0"}], TraditionalForm]], "Output",
  ExpressionUUID->"85c365b5-5a40-476f-825e-6c72e9d910a9"], "Output"],
 StyleBox[" and ", "Output"],
