Cell[TextData[{
 StyleBox["Conventions", "Output",
  FontWeight->"Bold"],
 StyleBox["\nHFT - An abbreviation for helically folded tube.\n", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   OverscriptBox["a", "~"], TraditionalForm]], "Output",ExpressionUUID->
  "be143996-1016-4a3b-a2ea-faa68982e427"], "Output"],
 StyleBox[" - A normalized geometric quantity is denoted with a tilde.\n", 
  "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "*"], TraditionalForm]], "Output",ExpressionUUID->
  "38299fa4-6ae6-4fff-be1d-1fdf48d36883"], "Output"],
 StyleBox[" - A characteristic quantity is denoted with a superscript \
asterisk.\n", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["a", "r"], TraditionalForm]], "Output",ExpressionUUID->
  "a1147c64-fd8f-4d2c-8329-1ca9ebc419de"], "Output"],
 StyleBox[" - The \[OpenCurlyDoubleQuote]r\[CloseCurlyDoubleQuote] subscript \
indicates that the quantity is in the reference configuration.\n", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["a", "0"], TraditionalForm]], "Output",ExpressionUUID->
  "2f19f3d0-060c-4be6-9548-21c853501021"], "Output"],
 StyleBox[" - The \[OpenCurlyDoubleQuote]0\[CloseCurlyDoubleQuote] subscript \
indicates that the quantity is in the initial configuration.\n", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["a", "d"], TraditionalForm]], "Output",ExpressionUUID->
  "1e03e12f-63de-4650-bc0a-415f5a7695b3"], "Output"],
 StyleBox[" - The \[OpenCurlyDoubleQuote]d\[CloseCurlyDoubleQuote] subscript \
indicates that the quantity is in the deformed configuration.\n", "Output"],
 StyleBox[Cell[BoxData[
  SuperscriptBox["a", 
   RowBox[{"(", "n", ")"}]]], "Output",ExpressionUUID->
  "f529065a-b723-418f-a6fb-e215451e1713"], "Output"],
