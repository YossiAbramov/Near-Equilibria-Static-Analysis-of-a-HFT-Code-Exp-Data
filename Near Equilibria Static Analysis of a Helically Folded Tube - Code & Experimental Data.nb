Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ALForceSol", " ", "=", 
   RowBox[{"FAL", "==", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"8", " ", "C1", " ", "\[Psi]", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox["\[Psi]", "2"], "-", 
                    SuperscriptBox["\[Psi]0", "2"]}], ")"}], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"ro", "-", "ri"}], ")"}], "3"]}], "+", 
                 RowBox[{"2", "C2", " ", 
                  RowBox[{"(", 
                   RowBox[{"\[Psi]", "-", "\[Psi]0"}], ")"}], 
                  RowBox[{"(", 
                   RowBox[{"ro", "-", "ri"}], ")"}]}]}], ")"}], "/.", 
               RowBox[{"C1", "->", " ", 
                RowBox[{
                 FractionBox[
                  RowBox[{"\[Pi]", " ", "My", " ", "h"}], 
                  RowBox[{"8", " ", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"ro", "-", "ri"}], ")"}], "3"]}]], 
                 RowBox[{"(", 
                  RowBox[{
                   FractionBox[
                    RowBox[{"ro", "+", "ri"}], "2"], "-", 
                   FractionBox[
                    RowBox[{"ro", "-", "ri"}], 
                    RowBox[{"Log", "[", 
                    FractionBox["ro", "ri"], "]"}]]}], ")"}]}]}]}], "/.", 
              RowBox[{"C2", "->", " ", 
               RowBox[{
                FractionBox[
                 RowBox[{"\[Pi]", " ", "My", " ", 
                  SuperscriptBox["h", "3"]}], 
                 RowBox[{"12", " ", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"ro", "-", "ri"}], ")"}], "2"]}]], 
                RowBox[{"Log", "[", 
                 FractionBox["ro", "ri"], "]"}]}]}]}], "/.", 
             RowBox[{"ri", "->", "ri0"}]}], "/.", 
            RowBox[{"ro", "->", "ro0"}]}], "/.", 
           RowBox[{"\[Psi]", "->", 
