Cell[TextData[{
 StyleBox["From the solution of the strain in the conical case (see Almen and \
Laszlo [1936] or Ilssar et al. [2022]), it is expected that the only \
non-negligible strain term is the helical strain term, ", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    RowBox[{"(", 
     RowBox[{"2", ",", "2"}], ")"}]], TraditionalForm]], "Output",
  ExpressionUUID->"0eb4fad5-adfa-48f4-8646-eb1782fa3a8e"], "Output"],
 StyleBox[". Here, I used an adapted normalization, which is known according \
to the conical solution, namely", "Output"]
}], "Text",
 CellChangeTimes->{{3.9237962852714243`*^9, 3.9237963685330906`*^9}, {
