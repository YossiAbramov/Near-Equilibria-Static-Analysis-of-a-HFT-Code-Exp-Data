Cell[BoxData[
 TagBox[GridBox[{
    {"FKobelev", "\<\"=\"\>", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"h", " ", 
        SubscriptBox["M", "y"], " ", "\[Pi]", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            SuperscriptBox["h", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "\[Zeta]"}], "+", 
              SubscriptBox["\[Zeta]", "0"]}], ")"}], " ", 
            SuperscriptBox[
             RowBox[{"Log", "[", 
              FractionBox["ro0", "ri0"], "]"}], "2"]}], 
           SqrtBox[
            RowBox[{"1", "+", 
             FractionBox[
              SubsuperscriptBox["\[Zeta]", "0", "2"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"ri0", "-", "ro0"}], ")"}], "2"]]}]]], "-", 
          FractionBox[
           RowBox[{"6", " ", 
            RowBox[{"(", 
             RowBox[{"ri0", "-", "ro0"}], ")"}], " ", "\[Zeta]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{
               SqrtBox[
                FractionBox[
                 RowBox[{
                  SuperscriptBox["ri0", "2"], "-", 
                  RowBox[{"2", " ", "ri0", " ", "ro0"}], "+", 
                  SuperscriptBox["ro0", "2"], "-", 
                  SuperscriptBox["\[Zeta]", "2"], "+", 
                  SubsuperscriptBox["\[Zeta]", "0", "2"]}], 
                 RowBox[{
                  SuperscriptBox["ri0", "2"], "-", 
                  RowBox[{"2", " ", "ri0", " ", "ro0"}], "+", 
                  SuperscriptBox["ro0", "2"], "+", 
                  SubsuperscriptBox["\[Zeta]", "0", "2"]}]]], " ", 
               SqrtBox[
                RowBox[{"1", "+", 
                 FractionBox[
                  SubsuperscriptBox["\[Zeta]", "0", "2"], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"ri0", "-", "ro0"}], ")"}], "2"]]}]]}]}], ")"}], 
            " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{"ri0", "-", "ro0"}], ")"}]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"ri0", "+", "ro0"}], ")"}], " ", 
               RowBox[{"Log", "[", 
                FractionBox["ro0", "ri0"], "]"}]}]}], ")"}]}], 
           SqrtBox[
            FractionBox[
             RowBox[{
              SuperscriptBox["ri0", "2"], "-", 
              RowBox[{"2", " ", "ri0", " ", "ro0"}], "+", 
              SuperscriptBox["ro0", "2"], "-", 
              SuperscriptBox["\[Zeta]", "2"], "+", 
              SubsuperscriptBox["\[Zeta]", "0", "2"]}], 
             RowBox[{
              SuperscriptBox["ri0", "2"], "-", 
              RowBox[{"2", " ", "ri0", " ", "ro0"}], "+", 
              SuperscriptBox["ro0", "2"], "+", 
              SubsuperscriptBox["\[Zeta]", "0", "2"]}]]]]}], ")"}]}], 
       RowBox[{"6", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"ri0", "-", "ro0"}], ")"}], "2"], " ", 
        RowBox[{"Log", "[", 
         FractionBox["ro0", "ri0"], "]"}]}]]}], "\<\".\"\>"}
   },
   AutoDelete->False,
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
