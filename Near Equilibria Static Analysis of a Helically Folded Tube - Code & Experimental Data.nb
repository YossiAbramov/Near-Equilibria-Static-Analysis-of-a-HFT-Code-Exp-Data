                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"ro", "-", "ri"}], ")"}], "3"]}]], 
                    RowBox[{"(", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"ro", "+", "ri"}], "2"], "-", 
                    FractionBox[
                    RowBox[{"ro", "-", "ri"}], 
                    RowBox[{"Log", "[", 
                    FractionBox["ro", "ri"], "]"}]]}], ")"}]}]}]}], "/.", 
                    RowBox[{"C2", "->", " ", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"\[Pi]", " ", "My", " ", 
                    SuperscriptBox["h", "3"]}], 
                    RowBox[{"12", " ", 
