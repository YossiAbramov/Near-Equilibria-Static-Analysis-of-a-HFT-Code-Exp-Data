  FormBox[
   OverscriptBox["\[Chi]", "^"], TraditionalForm]], "Output",ExpressionUUID->
  "449c688a-c604-4f8f-a41f-328f89672554"], "Output"],
 StyleBox[", ", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   OverscriptBox["c", "^"], TraditionalForm]], "Output",ExpressionUUID->
  "998b143d-5e42-4a7e-9d42-33abb630cc44"], "Output"],
 StyleBox[", and ", "Output"],
