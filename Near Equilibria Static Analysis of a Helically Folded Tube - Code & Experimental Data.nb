   SuperscriptBox["\[Epsilon]", "n"], TraditionalForm]], "Output",
  ExpressionUUID->"9ef89408-993f-477f-a804-c36e25aec0fb"], "Output"],
 StyleBox[" term in series expansions.\n", "Output"],
 StyleBox[Cell[BoxData[
 "da"], "Output",ExpressionUUID->"b6076eab-361f-4c8b-84bf-339feb3defed"], 
  "Output"],
