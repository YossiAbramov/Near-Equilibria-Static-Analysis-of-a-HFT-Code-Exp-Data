               RowBox[{"r", "->", "rneut"}]}], ")"}]}]}], ")"}]}], ",", 
         RowBox[{"\"\<\[Beta]\!\(\*SubscriptBox[\(|\), \(rneut\)]\)\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Beta]rEq", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/.", 
            RowBox[{"r", "->", "rneut"}]}], ")"}]}], ",", 
         RowBox[{"Q1", "->", 
          RowBox[{"Q1Eq", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}], "/.", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["rneut", "2"], 
        RowBox[{
         SuperscriptBox["rneut", "2"], "+", 
         RowBox[{
          SuperscriptBox["ro", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Tan", "[", "\[Beta]o", "]"}], "2"]}]}]], "+", 
       FractionBox[
        RowBox[{
         SuperscriptBox["ro", "2"], " ", 
         SuperscriptBox[
          RowBox[{"Tan", "[", "\[Beta]o", "]"}], "2"]}], 
        RowBox[{
         SuperscriptBox["rneut", "2"], "+", 
         RowBox[{
          SuperscriptBox["ro", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Tan", "[", "\[Beta]o", "]"}], "2"]}]}]]}], "->", "1"}]}], 
    "/.", 
    RowBox[{
     RowBox[{
      SuperscriptBox["rneut", "2"], "+", 
      RowBox[{
       SuperscriptBox["ro", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Tan", "[", "\[Beta]o", "]"}], "2"]}]}], "->", 
     RowBox[{
      SuperscriptBox["rneut", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{
          SuperscriptBox["ro", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Tan", "[", "\[Beta]o", "]"}], "2"]}], 
         SuperscriptBox["rneut", "2"]]}], ")"}]}]}]}]}], 
