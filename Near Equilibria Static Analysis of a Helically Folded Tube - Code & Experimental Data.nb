Cell[BoxData[{
 RowBox[{
  RowBox[{"KobelevForceLimitSol", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"FKobelevLimit", "==", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Normal", "[", 
             RowBox[{"Series", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "\[Pi]"}], " ", "My", " ", 
                    SuperscriptBox["ri", "2"], 
                    FractionBox[
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Fe", " ", "\[Mu]"}], "+", 
                    RowBox[{"Ff", " ", 
                    SuperscriptBox["\[Mu]", "3"]}]}], ")"}], 
                    RowBox[{"Cos", "[", "\[Psi]", "]"}]]}], "/.", 
                    RowBox[{"\[Mu]", "->", 
                    FractionBox["h", "ri"]}]}], "/.", 
                    RowBox[{"Fe", "->", 
                    RowBox[{
                    FractionBox[
                    RowBox[{
                    RowBox[{"2", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "+", "\[CapitalDelta]"}], ")"}], 
                    RowBox[{"Log", "[", "\[CapitalDelta]", "]"}]}]}], 
                    RowBox[{"Log", "[", "\[CapitalDelta]", "]"}]], 
                    FractionBox[
                    RowBox[{
                    RowBox[{"Cos", "[", "\[Psi]", "]"}], "-", 
                    RowBox[{"Cos", "[", "\[Psi]0", "]"}]}], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"Cos", "[", "\[Psi]0", "]"}], ")"}], "2"]], 
                    RowBox[{"Sin", "[", "\[Psi]", "]"}]}]}]}], "/.", 
                    RowBox[{"Ff", "->", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"Log", "[", "\[CapitalDelta]", "]"}], 
                    RowBox[{"6", 
