Cell[TextData[{
 "Note that taking the limit of the neutral radius obtained by A-L [1936] and \
Kobelev [2016] as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "e6c0f743-0766-48fb-a2a6-bdd32a8bfff6"],
 " approaching ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "o"], TraditionalForm]],ExpressionUUID->
  "4d7541f6-a43e-4454-a069-44a5d59d5efd"],
 ", which is equivalent to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i0"], TraditionalForm]],ExpressionUUID->
  "b8497f93-aa5a-45b1-b326-0ddfbddee77e"],
 " approaching ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "o0"], TraditionalForm]],ExpressionUUID->
  "7d4d643d-b7d9-4f54-ae95-42252378b08b"],
 ", results in ",
 Cell[BoxData[GridBox[{
    {
     SubscriptBox["r", "neut"], "=", 
     FractionBox[
      RowBox[{
       SubscriptBox["r", "i0"], "+", 
       SubscriptBox["r", "o0"]}], "2"]}
   },
   AutoDelete->False,
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]],
  CellChangeTimes->{{3.9457956244473534`*^9, 3.945795627916119*^9}},
  ExpressionUUID->"28e37b75-966e-4d76-b51a-9dbfec5fa5fa"],
 ", which enhances the validity of my obtained result."
}], "Text",
