45c298db9022"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "p", " ", "values", " ", "for", " ", "a", " ", "HFT", " ", "with", " ", 
    "8", " ", "mm", " ", "pitch", " ", 
    RowBox[{"in", " ", "[", "atm", "]"}], " ", "units"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"p", "[", "O", "]"}], "[", "8", "]"}], "=", 
     RowBox[{"0.001", "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "400"}], ",", 
        RowBox[{"-", "350"}], ",", 
        RowBox[{"-", "300"}], ",", 
        RowBox[{"-", "250"}], ",", 
        RowBox[{"-", "200"}], ",", 
        RowBox[{"-", "150"}], ",", 
        RowBox[{"-", "100"}], ",", 
