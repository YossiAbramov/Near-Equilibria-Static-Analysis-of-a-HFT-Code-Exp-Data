Cell[CellGroupData[{

Cell[TextData[StyleBox["Experimental Measurements",
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{{3.876907973266202*^9, 3.8769079788742447`*^9}, 
   3.8769082348434544`*^9, 
