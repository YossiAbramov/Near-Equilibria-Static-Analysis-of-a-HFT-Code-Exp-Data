Cell[BoxData[{
 RowBox[{
  RowBox[{"RN1Eq", "=", 
   RowBox[{"RN1", "==", 
    RowBox[{"rN1", "+", 
     RowBox[{"\[Epsilon]r", " ", "rN2"}], " ", "+", 
     RowBox[{
      SuperscriptBox["\[Epsilon]r", "2"], "rN3"}]}]}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rN1Eq", " ", "=", " ", 
   RowBox[{"rN1", "==", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RN1Eq", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", 
          RowBox[{"RN1Eq", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "rN1"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rNExpansion", " ", "=", " ", 
   RowBox[{"rN", "==", 
    RowBox[{"1", "-", 
     RowBox[{"\[Epsilon]r", " ", "rN1"}], " ", "-", 
     RowBox[{
      SuperscriptBox["\[Epsilon]r", "2"], " ", "rN2"}], " ", "-", 
     RowBox[{
      SuperscriptBox["\[Epsilon]r", "3"], " ", "rN3"}], " ", "+", 
     SuperscriptBox[
      RowBox[{"O", "[", "\[Epsilon]", "]"}], "4"]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rNExpansion1", " ", "=", 
   RowBox[{
    RowBox[{"rNExpansion", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "==", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"rNExpansion", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "/.", 
      RowBox[{"rN1", "->", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Solve", "[", 
