Cell[TextData[{
 StyleBox["where ", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["dV", "f"], "="}], TraditionalForm]], "Output",
  ExpressionUUID->"55bdfa50-c28c-459b-aacd-30080338e1d1"], "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["dx", "d"], 
