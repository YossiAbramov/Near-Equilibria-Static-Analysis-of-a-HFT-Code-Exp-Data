Cell[TextData[{
 StyleBox["Furthermore, similar to the conical frustum derivation (see Ilssar \
et al. [2022]), in the equation, which follows, I represent the normalized \
axial translation at ", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
