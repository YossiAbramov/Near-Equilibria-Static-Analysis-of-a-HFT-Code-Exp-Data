Cell["\<\
According to the conical frustum model obtained by Kobelev, the \
force-displacement relation is given by \
\>", "Text",
 CellChangeTimes->{{3.945063984406475*^9, 3.9450640061614447`*^9}, {
   3.9450642167593355`*^9, 3.9450642790108833`*^9}, {3.9450755752034855`*^9, 
   3.945075583316554*^9}, 3.9451807303040314`*^9, {3.9451808379696584`*^9, 
   3.945180879562707*^9}, {3.945181028602923*^9, 
   3.9451810559618154`*^9}},ExpressionUUID->"0b658406-7d79-4dee-957a-\
64fb0e43cedf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"KobelevForceSol", " ", "=", 
   RowBox[{"FKobelev", "==", 
    RowBox[{"-", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Pi]", " ", "My", " ", 
               SuperscriptBox["ri", "2"], 
               FractionBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Fe", " ", "\[Mu]"}], "+", 
                  RowBox[{"Ff", " ", 
                   SuperscriptBox["\[Mu]", "3"]}]}], ")"}], 
                RowBox[{"Cos", "[", "\[Psi]", "]"}]]}], "/.", 
              RowBox[{"\[Mu]", "->", 
               FractionBox["h", "ri"]}]}], "/.", 
             RowBox[{"Fe", "->", 
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"2", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "+", "\[CapitalDelta]"}], ")"}], 
                  RowBox[{"Log", "[", "\[CapitalDelta]", "]"}]}]}], 
                RowBox[{"Log", "[", "\[CapitalDelta]", "]"}]], 
               FractionBox[
                RowBox[{
                 RowBox[{"Cos", "[", "\[Psi]", "]"}], "-", 
                 RowBox[{"Cos", "[", "\[Psi]0", "]"}]}], 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"Cos", "[", "\[Psi]0", "]"}], ")"}], "2"]], 
               RowBox[{"Sin", "[", "\[Psi]", "]"}]}]}]}], "/.", 
            RowBox[{"Ff", "->", 
             RowBox[{
              FractionBox[
               RowBox[{"Log", "[", "\[CapitalDelta]", "]"}], 
               RowBox[{"6", 
                RowBox[{"(", 
                 RowBox[{"\[CapitalDelta]", "-", "1"}], ")"}]}]], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Sin", "[", "\[Psi]0", "]"}], "-", 
                RowBox[{"Sin", "[", "\[Psi]", "]"}]}], ")"}], 
              RowBox[{"Cos", "[", "\[Psi]", "]"}]}]}]}], "/.", 
           RowBox[{"\[CapitalDelta]", "->", 
            FractionBox["ro", "ri"]}]}], "/.", 
          RowBox[{"ri", "->", "ri0"}]}], "/.", 
         RowBox[{"ro", "->", "ro0"}]}], "/.", 
        RowBox[{"\[Psi]", "->", 
         RowBox[{"ArcSin", "[", 
          FractionBox["\[Zeta]", 
           RowBox[{
            FractionBox["ro0", 
             RowBox[{"Cos", "[", "\[Psi]0", "]"}]], "-", 
            FractionBox["ri0", 
             RowBox[{"Cos", "[", "\[Psi]0", "]"}]]}]], "]"}]}]}], "/.", 
       RowBox[{"\[Psi]0", "->", 
        RowBox[{"ArcTan", "[", 
         FractionBox["\[Zeta]0", 
          RowBox[{"ro0", "-", "ri0"}]], "]"}]}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"KobelevForceSol", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<=\>\"", ",", 
     RowBox[{"KobelevForceSol", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<.\>\""}], "}"}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.945066634026557*^9, 3.945066848596358*^9}, {
   3.945066886622797*^9, 3.9450669384788437`*^9}, 3.945067065478649*^9, {
