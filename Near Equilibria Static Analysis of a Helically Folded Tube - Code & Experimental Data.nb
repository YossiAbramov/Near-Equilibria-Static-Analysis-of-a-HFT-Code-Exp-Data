  FormBox[
   RowBox[{"\[Chi]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "Output",ExpressionUUID->
  "014fc051-b749-47eb-aac7-1631621fcfbe"], "Output"],
 StyleBox[" section. This force is generated by integrating the stresses, ", 
