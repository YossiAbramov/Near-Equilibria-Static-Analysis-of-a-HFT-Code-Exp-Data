Cell[TextData[{
 StyleBox["Note that the normalized force-displacement relation implies that \
the force, F, does not depend on the helical angle, ",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "o"], TraditionalForm]],
  FontFamily->"Consolas",
  FontWeight->"Normal",ExpressionUUID->"bd38ef27-bbdb-4ea2-a759-6344c532839b"],
 StyleBox[", at the leading order. Moreover, in the limiting case of zero \
helical angle, the problem reduces to a conical frustum problem. Thus, in the \
no-pressure case, the force-displacement relation of the upper helicoidal \
shell is required to conform to the A-L model of the conical frustum [1936] \
with the small parameters ",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "r"], ",", 
    SubscriptBox["\[Epsilon]", "\[CapitalDelta]\[Psi]"], ",", 
    RowBox[{
     SubscriptBox["\[Psi]", "0"], "=", 
     RowBox[{"O", "(", "\[Epsilon]", ")"}]}]}], TraditionalForm]],
  FontFamily->"Consolas",
  FontWeight->"Normal",ExpressionUUID->"e0c85ffb-77f4-4e1f-ae7a-e70d44e90bcd"],
 StyleBox[" and ",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "n"], "=", 
    RowBox[{"O", "(", 
     SuperscriptBox["\[Epsilon]", "2"], ")"}]}], TraditionalForm]],
  FontFamily->"Consolas",
  FontWeight->"Normal",ExpressionUUID->"d1a9be68-65d1-49ad-bf19-7f9bd29611fa"],
 StyleBox[", as well as to the Kobelev model of the conical frustum ",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 StyleBox["[2016] ", "Output",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 StyleBox["with the small parameters ",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 Cell[BoxData[
  FormBox[
   RowBox[{
