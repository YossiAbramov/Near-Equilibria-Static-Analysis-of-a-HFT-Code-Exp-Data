Cell[TextData[{
 StyleBox["Therefore, as the helical angle, ",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "o"], TraditionalForm]],
  FontFamily->"Consolas",
  FontWeight->"Normal",ExpressionUUID->"634a4c0e-4099-400e-8d2f-7963a27ed88d"],
 StyleBox[", approaches zero, a larger magnitude of torque, |T|, is required \
to maintain equilibrium. Moreover, in the limiting case of zero helical \
angle, equilibrium cannot be obtained by applying a finite torque value. \
However, the magnitude of the rotation angle, ",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SuperscriptBox["\[CapitalDelta]\[Theta]", 
     RowBox[{"(", "b", ")"}]], "|"}], TraditionalForm]],
  FontFamily->"Consolas",
  FontWeight->"Normal",ExpressionUUID->"a21f2e04-81cf-4077-9e06-7182bee4bbad"],
 StyleBox[", decreases as the helical angle, ",
  FontFamily->"Consolas",
  FontWeight->"Normal"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "o"], TraditionalForm]],
  FontFamily->"Consolas",
  FontWeight->"Normal",ExpressionUUID->"39403302-ccae-4b91-bfdb-8e9d6c275cf0"],
 StyleBox[", approaches zero, and in the limiting case of zero helical angle, \
the upper helicoidal shell does not rotate in the axial direction. As a \
result, in this limiting case, instead of applying torque to obtain \
equilibrium, it can be obtained by connecting the two ends of the upper \
helicoidal shell. This reduces the problem to a conical frustum problem.",
  FontFamily->"Consolas",
  FontWeight->"Normal"]
}], "Text",
