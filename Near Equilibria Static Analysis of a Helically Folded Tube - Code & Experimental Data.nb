    SubscriptBox["dz", "d"]}], TraditionalForm]], "Output",ExpressionUUID->
  "edab0674-7222-49ae-b490-45d4b72f6ad8"], "Output"],
 StyleBox[" is a volume differential element of the fluid.\nNote that the \
leading order term of ", "Output"],
 StyleBox[Cell[BoxData[
  RowBox[{
   RowBox[{"[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z", " ", "-", 
       SubscriptBox["z", "r"]}], ")"}], "-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["z", "0"], " ", "-", 
       SubscriptBox["z", "r"]}], ")"}]}], "]"}], 
   SubscriptBox["|", 
    RowBox[{"r", "=", 
     SubscriptBox["r", "i"]}]]}]], "Output",ExpressionUUID->
  "164bf39c-3d6a-49ea-972a-a6bac875e4b5"], "Output"],
 StyleBox[" does not depend on n, so that it is justified to neglect the n \
term contribution in the definition of ", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["V", "f"], TraditionalForm]], "Output",ExpressionUUID->
  "a5c73970-6160-427c-bd85-f7d58aa8e2c9"], "Output"],
 StyleBox[". The integral with respect to r may be split into the subtraction \
of two integrals over the intervals: ", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "r", "<", 
    SubscriptBox["r", "o"]}], TraditionalForm]], "Output",ExpressionUUID->
  "606f3b93-12b6-43fc-b192-5db99ee4dbe6"], "Output"],
 StyleBox[" and ", "Output"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "i"], "<", "r", "<", 
    SubscriptBox["r", "o"]}], TraditionalForm]], "Output",ExpressionUUID->
  "6625eea0-3413-4a07-b4bc-de34c2a8ecee"], "Output"],
 StyleBox[", where the second integral after normalization, is of a higher \
order and can thus be neglected. For the same reason, the work contribution \
of the lower helicoidal shell is neglected.", "Output"]
}], "Text",
